---
/**
 * Reading progress: a 4px bar fixed to the top of the viewport that grows from
 * the centre outwards as the page scrolls, as on the Framer site, but empty until the reader scrolls. Case studies only.
 * Wider than the viewport by 88px a side, so it fully covers the top edge at the end.
 */
---

<div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>

<style>
  .progress {
    position: fixed;
    z-index: 50;
    top: 0;
    inset-inline: -88px;
    height: 4px;
    overflow: hidden;
    pointer-events: none;
  }
  .progress-bar {
    height: 100%;
    background: var(--color-brand);
    transform: scaleX(var(--progress, 0));
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".progress-bar");
  let ticking = false;
  function paint() {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    bar?.style.setProperty("--progress", p.toFixed(4));
  }
  const request = () => !ticking && ((ticking = true), requestAnimationFrame(paint));
  addEventListener("scroll", request, { passive: true });
  addEventListener("resize", request);
  // Late-loading images change the page height.
  new ResizeObserver(request).observe(document.body);
  paint();
</script>
