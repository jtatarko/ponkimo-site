---
import Wordmark from "../assets/svg/wordmark.svg";
import Arrow from "../assets/svg/arrow.svg";
import { site } from "../data/site";

interface Props {
  next?: { href: string; label: string };
}
const { next } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-line bg-nav backdrop-blur-md supports-[backdrop-filter]:bg-nav"
>
  <nav class="flex h-nav items-center gap-6 px-4" aria-label="Main">
    <a href="/" class="inline-flex min-h-11 shrink-0 items-center" aria-label={`${site.name}, home`}>
      <Wordmark class="h-[22px] w-24" aria-hidden="true" />
    </a>
    <a href={site.links.linkedin} class="link-brand inline-flex min-h-11 items-center text-label" rel="me noopener" target="_blank">
      LinkedIn
    </a>
    {
      next && (
        <a href={next.href} class="link-brand ml-auto inline-flex min-h-11 items-center gap-2 text-label">
          Explore next
          <span class="sr-only">: {next.label}</span>
          <Arrow class="h-[9px] w-[14px]" aria-hidden="true" />
        </a>
      )
    }
  </nav>
</header>
