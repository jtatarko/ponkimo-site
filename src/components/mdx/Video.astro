---
/** Silent looping clip (replaces Framer's autoplay video blocks). */
interface Props {
  /** Path under /public, e.g. /media/frog/demo.mp4 */
  src: string;
  label: string;
  poster?: string;
  caption?: string;
  /** Placement inside a <Canvas>, in Framer pixels: [x, y, w, h?]. */
  at?: [number, number, number, number?];
  /** Mobile placement inside a <Canvas mh>: [x, y, w] in px on a 390px-wide frame, y from the top of the image area. */
  m?: [number, number, number];
  /** Caption directly above or below the clip; inside a <Canvas mh> it sets the mobile placement too. */
  mcap?: "above-image" | "below-image";
  /** Scroll parallax speed (fraction of scroll; negative moves faster). Desktop only. */
  parallax?: number;
  /** Intrinsic aspect ratio, avoids layout shift before metadata loads. */
  ratio?: string;
}
const { src, label, poster, caption, at, m, mcap = "above-image", parallax, ratio = "16 / 9" } = Astro.props;
const [x, y, w] = at ?? [];
const mStyle = m ? `;--mx:${m[0]};--my:${m[1]};--mw:${m[2]}` : "";
const below = mcap === "below-image";
---

<figure
  data-parallax={parallax}
  data-at={at ? "" : undefined}
  data-m={m ? "" : undefined}
  data-mcap={m ? mcap : undefined}
  style={(at ? `--x:${x};--y:${y};--w:${w}` : "") + mStyle || undefined}
  class:list={["reveal", !at && "my-10 lg:my-12"]}
>
  {caption && !below && <figcaption class="mb-caption text-caption text-muted">{caption}</figcaption>}
  <video
    class="h-auto w-full rounded-lg bg-line/30 object-cover dark:brightness-[.8] dark:transition-[filter] dark:duration-300 dark:hover:brightness-100"
    style={`aspect-ratio:${ratio}`}
    src={src}
    poster={poster}
    aria-label={label}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"></video>
  {caption && below && <figcaption class="mt-caption text-caption text-muted">{caption}</figcaption>}
</figure>

<script>
  // Pause clips while off-screen and honour reduced motion.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const io = new IntersectionObserver((entries) => {
    for (const { target, isIntersecting } of entries) {
      const v = target as HTMLVideoElement;
      if (isIntersecting && !reduce) v.play().catch(() => {});
      else v.pause();
    }
  });
  document.querySelectorAll<HTMLVideoElement>("figure video[autoplay]").forEach((v) => {
    if (reduce) v.removeAttribute("autoplay");
    io.observe(v);
  });
</script>
