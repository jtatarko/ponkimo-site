---
interface Props {
  name: string;
  role?: string;
}
const { name, role } = Astro.props;
---

<figure class="page reveal my-16 text-center lg:my-28">
  <div class="mx-auto max-w-[45rem]">
    <span aria-hidden="true" class="block font-sans text-[6.75rem] leading-[0.6] text-brand">“</span>
    <blockquote class="mt-6 text-lead [&>*+*]:mt-[1em]">
      <slot />
    </blockquote>
    <figcaption class="mt-8">
      <span class="block text-intro font-semibold">{name}</span>
      {role && <span class="block text-caption text-muted">{role}</span>}
    </figcaption>
  </div>
</figure>
