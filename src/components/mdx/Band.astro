---
/** Full-width dark strip behind a <Canvas> of showcase imagery. */
interface Props {
  /** Framer px of space above this block at 1440 wide (desktop only). */
  gap?: number;
}
const { gap } = Astro.props;
---

<div
  data-gap={gap !== undefined ? "" : undefined}
  style={gap !== undefined ? `--gap:${gap}` : undefined}
  class="my-10 bg-band py-2 text-on-band lg:my-12 [&_.canvas]:my-6 [&_.text-muted]:text-on-band/70">
  <slot />
</div>
