---
/**
 * Free-form arrangement of figures, reproducing Framer's absolute layouts.
 *
 * Children are <Figure>/<Video>/<Caption> with `at={[x, y, w]}` in Framer
 * pixels on a 1440px-wide frame, `y` relative to the top of this canvas.
 * On desktop the canvas keeps the 1440:h proportion and places children by
 * percentage, so overlaps and offsets survive at any width. Below lg the
 * children simply stack in source order, unless the canvas has `mh`: then it
 * reproduces Framer's 390px mobile layout, edge to edge, scaled with the
 * viewport. Children place themselves with `m` (see Figure, Caption, Video).
 */
interface Props {
  /** Canvas height in Framer pixels (at 1440px width). */
  h: number;
  /** Framer px of space above this block at 1440 wide (desktop only). */
  gap?: number;
  /** Canvas height in Framer pixels on mobile (at 390px width). */
  mh?: number;
}
const { h, gap, mh } = Astro.props;
---

<div
  class:list={["canvas my-10 lg:my-12", !mh && "max-lg:px-gutter"]}
  data-gap={gap !== undefined ? "" : undefined}
  data-mh={mh !== undefined ? "" : undefined}
  style={`--h:${h}` + (gap !== undefined ? `;--gap:${gap}` : "") + (mh !== undefined ? `;--mh:${mh}` : "")}
>
  <div class="canvas-frame">
    <slot />
  </div>
</div>

<style is:global>
  @media (min-width: 64rem) {
    .canvas-frame {
      position: relative;
      margin-inline: auto;
      max-width: var(--container-page);
      aspect-ratio: 1440 / var(--h);
    }
    .canvas-frame > [data-at] {
      position: absolute;
      margin: 0;
      left: calc(var(--x) / 1440 * 100%);
      top: calc(var(--y) / var(--h) * 100%);
      width: calc(var(--w) / 1440 * 100%);
    }
  }
  @media (max-width: 63.999rem) {
    .canvas:not([data-mh]) .canvas-frame {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .canvas-frame > [data-at] {
      margin: 0;
    }

    /*
     * Framer's mobile layout: px on a 390px frame, scaled by the frame width.
     * Three rows: captions above, the image area (absolute layout, mh tall),
     * captions below. Captions flow, so they keep one caption gap from the
     * images however many lines they wrap to.
     */
    .canvas[data-mh] .canvas-frame {
      --u: calc(100cqw / 390);
      position: relative;
      container-type: inline-size;
      display: grid;
      grid-template-rows: auto auto auto;
    }
    .canvas[data-mh] .canvas-frame::before {
      content: "";
      grid-area: 2 / 1;
      aspect-ratio: 390 / var(--mh);
    }
    .canvas[data-mh] .canvas-frame > p,
    .canvas[data-mh] .m-figure > figcaption {
      grid-area: 1 / 1;
      margin: 0 0 var(--spacing-caption);
      padding-inline: calc(32 * var(--u));
    }
    .canvas[data-mh] .canvas-frame > p[data-mcap="below"],
    .canvas[data-mh] .m-figure[data-mcap="below"] > figcaption {
      grid-area: 3 / 1;
      margin: var(--spacing-caption) 0 0;
    }
    /* Figures dissolve so their caption and frames join the grid directly. */
    .canvas[data-mh] .canvas-frame > .m-figure {
      display: contents;
    }
    .canvas[data-mh] .m-frame {
      position: absolute;
      grid-area: 2 / 1;
      inset-inline: 0;
      top: calc(var(--fy) * var(--u));
      height: calc(var(--fh) * var(--u));
      overflow: hidden;
    }
    .canvas[data-mh] .m-frame > img {
      position: absolute;
      max-width: none;
      left: calc(var(--ix) * var(--u));
      top: calc(var(--iy) * var(--u));
      width: calc(var(--iw) * var(--u));
      height: calc(var(--ih) * var(--u));
    }
    .canvas[data-mh] .canvas-frame > figure[data-m] {
      position: absolute;
      grid-area: 2 / 1;
      left: calc(var(--mx) * var(--u));
      top: calc(var(--my) * var(--u));
      width: calc(var(--mw) * var(--u));
    }
  }
</style>
