---
/**
 * A case-study chapter: heading in the left column (sticky on desktop),
 * text in the right column. Figures passed with slot="aside" sit in the left
 * column beside the text, as Framer laid out illustrations next to paragraphs.
 */
interface Props {
  title?: string;
  /** Draw a hairline above the section, as Framer did between chapters. */
  divider?: boolean;
  /** Framer px of space above this block at 1440 wide (desktop only). */
  gap?: number;
}
const { title, divider = false, gap } = Astro.props;
const id = title?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const hasAside = Astro.slots.has("aside");
// A section with only a heading (e.g. "Solved challenges") spans the full width.
const headingOnly = !!title && !hasAside && !Astro.slots.has("default");
---

<section
  id={id}
  data-gap={gap !== undefined ? "" : undefined}
  data-divider={divider ? "" : undefined}
  style={gap !== undefined ? `--gap:${gap}` : undefined}
  class:list={[
    "page grid gap-y-6 pb-10 lg:grid-cols-2 lg:pb-12",
    // Framer left ~240px between chapters, with the hairline in the middle.
    divider
      ? "relative mt-12 pt-12 before:absolute before:inset-x-gutter before:top-0 before:h-px before:bg-line lg:mt-24 lg:pt-24"
      : "pt-10 lg:pt-12",
  ]}
>
  {
    (title || hasAside) && (
      <div class:list={["flex flex-col gap-10 lg:pr-12", headingOnly && "lg:col-span-2"]}>
        {title && <h2 class="reveal text-heading">{title}</h2>}
        {hasAside && (
          <div class="max-w-[34rem] [&>figure]:my-0 [&>figure+figure]:mt-10">
            <slot name="aside" />
          </div>
        )}
      </div>
    )
  }
  {
    !headingOnly && (
      <div class="prose-cs max-w-[35rem] lg:col-start-2">
        <slot />
      </div>
    )
  }
</section>
