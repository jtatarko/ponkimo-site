---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * size:
 *  - column: fits the text column it sits in (default inside <Section>)
 *  - wide:   page container width
 *  - bleed:  full viewport width
 *  - left / right: half the page, pinned to that side (Framer's offset shots)
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: "column" | "wide" | "bleed" | "left" | "right";
  /** Max rendered width in px, for small inline images. */
  width?: number;
  class?: string;
}
const { src, alt, caption, size = "column", width, class: className } = Astro.props;

const wrap = {
  column: "",
  wide: "page",
  bleed: "w-full",
  left: "page lg:pr-[50%]",
  right: "page lg:pl-[50%]",
}[size];
const sizes = {
  column: "(min-width: 1024px) 560px, 100vw",
  wide: "(min-width: 1440px) 1280px, 100vw",
  bleed: "100vw",
  left: "(min-width: 1024px) 50vw, 100vw",
  right: "(min-width: 1024px) 50vw, 100vw",
}[size];
---

<figure class:list={["reveal my-10 lg:my-16", wrap, className]}>
  {caption && size !== "column" && <figcaption class="mb-3 text-caption text-muted">{caption}</figcaption>}
  <Image
    src={src}
    alt={alt}
    sizes={width ? `${width}px` : sizes}
    widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= src.width)}
    style={width ? `max-width:${width}px` : undefined}
    class="h-auto w-full"
  />
  {caption && size === "column" && <figcaption class="mt-3 text-caption text-muted">{caption}</figcaption>}
</figure>
