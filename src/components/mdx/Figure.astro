---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Inside a text column (default) the image fills the column.
 * Inside a <Canvas>, pass `at={[x, y, w, h]}` in Framer pixels to place it.
 * When the box ratio differs from the file, the image is cropped to the box
 * (object-fit: cover), which is what Framer did.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  at?: [number, number, number, number?];
  /** Box ratio "w / h" for figures outside a canvas. */
  ratio?: string;
  /** Max rendered width in px, for small inline images. */
  width?: number;
  /**
   * "art": line art on white (Framer's multiply-blended images). In dark mode it
   * is inverted and screened into the page at reduced opacity.
   * "shot" (default): screenshots, dimmed slightly in dark mode.
   */
  tone?: "art" | "shot";
  /** Crop anchor (CSS object-position) when the box crops the image. */
  pos?: string;
  /** Extra space above, in px on desktop (aligns an aside with its paragraph). */
  offset?: number;
  class?: string;
}
const { src, alt, caption, at, ratio, width, pos, tone = "shot", offset, class: className } = Astro.props;
const [x, y, w, h] = at ?? [];
const box = at && h ? `${w} / ${h}` : ratio;
const sizes = at
  ? `(min-width: 1024px) ${Math.round((w! / 1440) * 100)}vw, 100vw`
  : width
    ? `${width}px`
    : "(min-width: 1024px) 560px, 100vw";
---

<figure
  data-at={at ? "" : undefined}
  style={at ? `--x:${x};--y:${y};--w:${w}` : offset ? `--offset:${offset}px` : undefined}
  class:list={["reveal", !at && "my-10 first:mt-0 lg:my-12", offset && "lg:!mt-[var(--offset)]", className]}
>
  {caption && <figcaption class="mb-3 text-caption text-muted">{caption}</figcaption>}
  <Image
    src={src}
    alt={alt}
    sizes={sizes}
    widths={[480, 800, 1200, 1600, 2400].filter((v) => v <= src.width)}
    style={[box && `aspect-ratio:${box}`, width && `max-width:${width}px`, pos && `object-position:${pos}`].filter(Boolean).join(";") || undefined}
    class:list={[
      "w-full",
      box ? "object-cover" : "h-auto",
      tone === "art"
        ? "dark:opacity-65 dark:mix-blend-screen dark:invert"
        : "dark:brightness-[.8] dark:transition-[filter] dark:duration-300 dark:hover:brightness-100",
    ]}
  />
</figure>
