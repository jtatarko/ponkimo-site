<style>
  .venn-circle {
    fill: transparent;
    stroke: var(--color-content);
    stroke-opacity: 0.4;
    stroke-miterlimit: 10;
  }
  .venn-label { fill: var(--color-content); }
  .venn-spot {
    fill: var(--color-brand);
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .venn-circle { stroke-dasharray: 1 2; stroke-dashoffset: 1; }
    .venn-label { opacity: 0; }
    .venn-spot { opacity: 0; transform: scale(0.5); }

    :global(.venn-playing) .venn-circle {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--at) * 1s + 0.2s);
    }
    :global(.venn-playing) .venn-label {
      opacity: 1;
      transition: opacity 0.6s ease-out calc(var(--at) * 1s + 0.2s);
    }
    /* The sweet spot lands with a small overshoot, after the last circle closes. */
    :global(.venn-playing) .venn-spot {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.3s ease-out 2.1s,
        transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 2.1s;
    }
  }
</style>
