<style>
  .process {
    --ink: #454cff;
    color: var(--ink);
    overflow: visible;
  }
  @media (prefers-color-scheme: dark) {
    .process { --ink: var(--color-brand); }
  }

  .process-lines path {
    stroke: var(--ink);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .process-annotations path[data-fade] { fill: var(--ink); }
  .process-annotations path[data-stroke] { stroke: var(--ink); stroke-width: 2; }

  @media (min-width: 64rem) {
    .process-lines path { stroke-width: 2; }
    .process-annotations path[data-stroke] { stroke-width: 1; }
  }

  /* Initial hidden states; the script adds .is-playing, then .is-done. */
  @media (prefers-reduced-motion: no-preference) {
    .process-lines {
      visibility: hidden;
    }
    .process-lines path { stroke-dasharray: 1 2; stroke-dashoffset: 1; }
    .process-annotations path[data-fade] { opacity: 0; }
    .process-annotations path[data-stroke] { stroke-dasharray: 1 2; stroke-dashoffset: 1; }

    .is-playing .process-annotations path[data-fade] {
      opacity: 1;
      transition: opacity 0.7s ease-out calc(var(--at) * 1s + 0.5s);
    }
    .is-playing .process-annotations path[data-stroke] {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--at) * 1s + 0.5s);
    }
    .is-playing .process-lines { visibility: visible; }

  }
</style>

<script>
  const svg = document.querySelector<SVGSVGElement>("[data-process]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  if (svg && !reduced.matches) {
    const main = svg.querySelector<SVGPathElement>("#process-main")!;

    const START = 0.5; // s after the hero is in view; the title is rising by then
    const MAIN_DURATION = 3.4;

    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    const outCubic = (u: number) => 1 - (1 - u) ** 3;
    const inOutSine = (u: number) => 0.5 - Math.cos(Math.PI * u) / 2;

    // Frantic through the tangle (first ~80% of the length in half the time),
    // then a long ease-out into the straight line.
    const FAST = 0.8;
    const mainProgress = (u: number) =>
      u < 0.5 ? FAST * (u / 0.5) : FAST + (1 - FAST) * outCubic((u - 0.5) / 0.5);

    // Wobble: the lines are resampled into points that drift on slow sine fields.
    // Amplitude fades to zero between CALM_FROM and CALM_TO (viewBox x), so the
    // straight end never moves. Vector all the way, so lines stay crisp.
    const STEP = 5;
    const AMPLITUDE = 7;
    const CALM_FROM = 700;
    const CALM_TO = 1350;

    type Wobbly = { el: SVGPathElement; x: number[]; y: number[]; w: number[]; live: number; tail: string };

    function sample(el: SVGPathElement): Wobbly {
      const length = el.getTotalLength();
      const n = Math.ceil(length / STEP);
      const x: number[] = [];
      const y: number[] = [];
      const w: number[] = [];
      for (let i = 0; i <= n; i++) {
        const p = el.getPointAtLength((i / n) * length);
        const t = clamp01((p.x - CALM_FROM) / (CALM_TO - CALM_FROM));
        x.push(p.x);
        y.push(p.y);
        w.push(1 - t * t * (3 - 2 * t));
      }
      // Everything after the last point that can move is static: bake it once.
      let live = w.length;
      while (live > 0 && w[live - 1] === 0) live--;
      const tail = x
        .slice(live)
        .map((px, i) => `L${px.toFixed(1)} ${y[live + i].toFixed(1)}`)
        .join("");
      return { el, x, y, w, live, tail };
    }

    function drift(l: Wobbly, t: number, ramp: number) {
      let d = "";
      for (let i = 0; i < l.live; i++) {
        const px = l.x[i];
        const py = l.y[i];
        const a = AMPLITUDE * ramp * l.w[i];
        const dx = a * (Math.sin(px * 0.011 + py * 0.007 + t * 0.9) + Math.sin(py * 0.013 - px * 0.005 + t * 0.6)) * 0.5;
        const dy = a * (Math.sin(py * 0.012 - px * 0.006 + t * 0.7) + Math.sin(px * 0.009 + py * 0.01 - t * 0.5)) * 0.5;
        d += `${i ? "L" : "M"}${(px + dx).toFixed(1)} ${(py + dy).toFixed(1)}`;
      }
      l.el.setAttribute("d", d + l.tail);
    }

    function wobble() {
      const line = sample(main);
      line.el.style.strokeDasharray = "none";
      let visible = true;
      new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(svg!);
      const start = performance.now();
      let last = 0;
      function frame(now: number) {
        requestAnimationFrame(frame);
        if (!visible || now - last < 33) return;
        last = now;
        const t = (now - start) / 1000;
        const ramp = inOutSine(clamp01(t / 2.5));
        drift(line, t, ramp);
      }
      requestAnimationFrame(frame);
    }

    function play() {
      svg!.classList.add("is-playing");
      const t0 = performance.now() + START * 1000;

      function frame(now: number) {
        const t = (now - t0) / 1000;
        if (t < 0) return requestAnimationFrame(frame);

        const pm = mainProgress(clamp01(t / MAIN_DURATION));
        main.style.strokeDashoffset = String(1 - pm);

        if (t < MAIN_DURATION) return requestAnimationFrame(frame);
        main.style.strokeDashoffset = "0";
        svg!.classList.add("is-done");
        wobble();
      }
      requestAnimationFrame(frame);
    }

    // Once per page load, as soon as the hero is actually on screen.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(svg);
  }
</script>
