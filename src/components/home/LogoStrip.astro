---
import { Image } from "astro:assets";
import logo365 from "../../assets/logos/365.svg";
import adverity from "../../assets/logos/adverity.svg";
import jlr from "../../assets/logos/jaguar-land-rover.png";
import schochman from "../../assets/logos/schochman.png";
import skoda from "../../assets/logos/skoda.svg";
import uefa from "../../assets/logos/uefa.svg";

// Heights match the optical sizes Framer used at 1440px. They're set explicitly
// because some SVGs ship without width/height and collapse with h-auto.
const logos = [
  { src: logo365, alt: "365", h: 61 },
  { src: adverity, alt: "Adverity", h: 37 },
  { src: schochman, alt: "Schochman", h: 38 },
  { src: jlr, alt: "Jaguar Land Rover", h: 42 },
  { src: skoda, alt: "Škoda", h: 88 },
  { src: uefa, alt: "UEFA", h: 45 },
];
---

<section
  class="page relative isolate mt-20 lg:mt-24 dark:before:absolute dark:before:inset-x-[calc(var(--spacing-gutter)-1rem)] dark:before:-top-12 dark:before:-bottom-8 dark:before:-z-10 dark:before:bg-logo-slab dark:before:content-['']"
  aria-labelledby="worked-with"
>
  <!--
    The marks are full-colour artwork (Land Rover, Škoda, ...) and don't survive
    recolouring, so in dark mode they sit on a light slab, as in the original.
  -->
  <h2 id="worked-with" class="font-sans text-label font-normal text-muted lg:pl-6 dark:text-[#545454]">Worked with</h2>
  <ul
    class="mt-8 grid grid-cols-2 items-center gap-x-8 gap-y-10 sm:grid-cols-3 lg:flex lg:justify-between lg:px-6"
    role="list"
  >
    {
      logos.map(({ src, alt, h }) => (
        <li class="reveal flex justify-center">
          <Image
            src={src}
            alt={alt}
            height={h}
            style={`height:${h}px`}
            class="w-auto max-w-[11rem] object-contain max-lg:scale-90"
          />
        </li>
      ))
    }
  </ul>
</section>
