---
import Mark from "../../assets/svg/mark.svg";
import ProcessScribble from "./ProcessScribble.astro";
import { site } from "../../data/site";
---

<section class="page pt-16 lg:pt-52">
  <div class="lg:px-16">
    <Mark class="h-[68px] w-[72px]" aria-hidden="true" />
    <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <!-- Same entrance as the case-study titles; the rest of the hero is static. -->
      <h1 class="hero-title text-display">
        Innovative<br />Products,<br /><em class="font-medium">Faster.</em>
      </h1>
      <p class="text-body lg:mb-3 lg:whitespace-nowrap">
        {site.author} |<br />{site.role}
      </p>
    </div>
  </div>

  <!-- Research -> Concept -> Design scribble: ambiguity resolving into clarity. Draws itself on load. -->
  <figure class="mt-16 lg:mt-20 lg:px-16" data-parallax="-0.08" data-parallax-from="top" data-parallax-clamp="1200">
    <ProcessScribble />
  </figure>

  <!-- Bullets trail each skill so a wrapped line never starts with one. -->
  <ul data-parallax="-0.04" data-parallax-from="top" data-parallax-clamp="750" class="mt-6 flex flex-wrap justify-start gap-x-3 gap-y-1 text-body text-muted lg:justify-center" role="list">
    {
      site.skills.map((skill, i) => (
        <li class="flex items-center gap-3">
          {skill}
          {i < site.skills.length - 1 && <span aria-hidden="true">•</span>}
        </li>
      ))
    }
  </ul>
</section>
