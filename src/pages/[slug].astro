---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../assets/svg/mark.svg";
import * as mdx from "../components/mdx";

export const getStaticPaths = (async () => {
  const work = await getCollection("work", ({ data }) => import.meta.env.DEV || !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const next = await getEntry(entry.data.next);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.hero ?? entry.data.cardIllustration}
  next={next && { href: `/${next.id}`, label: next.data.title }}
>
  <article>
    <!-- Framer at 1440: mark at y=200, title 800px wide, illustration 576px at top right. -->
    <header class="page relative pt-12 lg:pt-[8.5rem]">
      {
        entry.data.hero && (
          <Image
            src={entry.data.hero}
            alt={entry.data.heroAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 576px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="mx-auto mb-8 h-auto w-full max-w-[24rem] lg:absolute lg:top-[5rem] lg:right-gutter lg:mb-0 lg:w-[40%] lg:max-w-[36rem] dark:opacity-65 dark:mix-blend-screen dark:invert"
          />
        )
      }
      <div class="relative">
        <Mark class="h-[68px] w-[72px]" aria-hidden="true" />
        <!-- Only the title animates in, as on Framer; mark, illustration and lead are static. -->
        <h1 class="hero-title mt-4 max-w-[50rem] text-title">{entry.data.title}</h1>
      </div>
    </header>

    <Content components={mdx} />

    {
      next && (
        <nav class="page mt-24 border-t border-line pt-12" aria-label="Next case study">
          <a href={`/${next.id}`} class="group block">
            <span class="text-label text-muted">Next: {next.data.client}</span>
            <span class="mt-2 flex items-center gap-4 font-display text-heading font-medium">
              {next.data.title}
              <span aria-hidden="true" class="text-brand transition-transform group-hover:translate-x-2">→</span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>
